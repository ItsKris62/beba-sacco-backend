generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  schemaName            String                 @unique
  status                TenantStatus           @default(ACTIVE)
  settings              Json?
  contactEmail          String
  contactPhone          String
  address               String?
  logoUrl               String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accounts              Account[]
  accountTypePolicies   AccountTypePolicy[]
  auditChainHead        AuditChainHead?
  auditEvents           AuditEvent[]
  auditLogs             AuditLog[]
  dataImportLogs        DataImportLog[]
  documents             Document[]
  glAccounts            GLAccount[]
  guarantors            LoanGuarantor[]
  journalEntries        JournalEntry[]
  loans                 Loan[]
  loanProducts          LoanProduct[]
  members               Member[]
  pinVerifications      PinVerification[]
  reportJobs            ReportJob[]
  supportTickets        SupportTicket[]
  counter               TenantCounter?
  ticketAttachments     TicketAttachment[]
  ticketMessages        TicketMessage[]
  transactions          Transaction[]
  users                 User[]
  webhookSubscriptions  WebhookSubscription[]
  auditArchiveManifests AuditArchiveManifest[]
  kycRequirements       KYCRequirement[]

  @@index([slug])
  @@index([status])
  @@schema("public")
}

model TenantCounter {
  id         String @id @default(uuid())
  tenantId   String @unique
  memberSeq  Int    @default(0)
  accountSeq Int    @default(0)
  loanSeq    Int    @default(0)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model User {
  id                     String            @id @default(uuid())
  tenantId               String
  email                  String
  passwordHash           String
  tempPasswordEncrypted  String?
  role                   UserRole          @default(MEMBER)
  firstName              String
  lastName               String
  phone                  String?
  emailVerified          Boolean           @default(false)
  refreshToken           String?
  lastLoginAt            DateTime?
  mustChangePassword     Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  idNumber               String?           @unique
  importBatchId          String?
  legacyMemberNo         String?
  nextOfKinPhone         String?
  passwordResetExpiry    DateTime?
  passwordResetToken     String?
  phoneNumber            String?           @unique
  wardId                 String?
  createdById            String?
  approvedById           String?
  approvedAt             DateTime?
  approvalReason         String?
  accountStatus          AccountStatus     @default(PENDING)
  backupCodes            String[]
  totpEnrolledAt         DateTime?
  totpSecret             String?
  twoFactorEnabled       Boolean           @default(false)
  lastPasswordChangeAt   DateTime          @default(now())
  phoneVerified          Boolean           @default(false)
  pinLoginRequired       Boolean           @default(false)
  auditLogs              AuditLog[]
  approvedJournalEntries JournalEntry[]    @relation("JournalEntryApprover")
  createdJournalEntries  JournalEntry[]    @relation("JournalEntryCreator")
  rejectedJournalEntries JournalEntry[]    @relation("JournalEntryRejector")
  member                 Member?
  pinVerifications       PinVerification[]
  requestedReports       ReportJob[]
  stageAssignments       StageAssignment[]
  assignedSupportTickets SupportTicket[]   @relation("AssignedSupportTickets")
  sentTicketMessages     TicketMessage[]
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@index([accountStatus])
  @@index([idNumber])
  @@index([importBatchId])
  @@index([phone])
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?  @unique
  timestamp  DateTime @default(now())
  entryHash  String?
  prevHash   String?
  oldValue   Json?
  newValue   Json?
  payload    Json?
  user       User?    @relation(fields: [actorId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, entityType, action])
  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
  @@schema("public")
}

model PinVerification {
  id            String     @id @default(uuid())
  tenantId      String
  userId        String
  purpose       PinPurpose
  codeHash      String
  length        Int
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  attempts      Int        @default(0)
  requestedByIp String?
  createdAt     DateTime   @default(now())
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([tenantId, expiresAt])
  @@schema("public")
}

model AuditEvent {
  id            String   @id @default(uuid())
  correlationId String
  timestamp     DateTime @default(now())
  tenantId      String
  userId        String?
  role          String?
  action        String
  resourceType  String?
  resourceId    String?
  oldState      Json?
  newState      Json?
  metadata      Json?
  ip            String?
  userAgent     String?
  endpoint      String?
  method        String?
  statusCode    Int
  success       Boolean
  errorCode     String?
  prevHash      String
  eventHash     String
  signature     String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventHash])
  @@index([tenantId, timestamp(sort: Desc)])
  @@index([correlationId])
  @@schema("public")
}

model AuditChainHead {
  tenantId  String   @id
  lastHash  String
  sequence  BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model AuditArchiveManifest {
  id           String   @id @default(uuid())
  tenantId     String
  archiveClass String
  cutoffAt     DateTime
  objectUri    String
  rowCount     Int
  manifestHash String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, cutoffAt(sort: Desc)])
  @@map("audit_archive_manifests")
  @@schema("public")
}

model Member {
  id                  String             @id @default(uuid())
  tenantId            String
  userId              String             @unique
  memberNumber        String
  nationalId          String?
  kraPin              String?
  employer            String?
  occupation          String?
  dateOfBirth         DateTime?
  isActive            Boolean            @default(true)
  joinedAt            DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  consentDataSharing  Boolean            @default(false)
  consentUpdatedAt    DateTime?
  deletedAt           DateTime?
  kycRejectionReason  String?
  kycReviewedAt       DateTime?
  kycReviewedByUserId String?
  kycStatus           KycStatus          @default(PENDING_UPLOAD)
  kycChecklist        Json?
  kycReviewNotes      String?
  isBlacklisted       Boolean            @default(false)
  accounts            Account[]
  documents           Document[]
  guarantors          LoanGuarantor[]
  loans               Loan[]
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageAssignments    MemberStage[]
  mpesaTransactions   MpesaTransaction[]
  supportTickets      SupportTicket[]

  @@unique([tenantId, memberNumber])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, kycStatus])
  @@schema("public")
}

model Document {
  id                 String         @id @default(uuid())
  tenantId           String
  memberId           String
  uploadedById       String
  objectKey          String
  originalFileName   String
  mimeType           String
  sizeBytes          Int
  checksum           String?
  type               DocumentType
  status             DocumentStatus @default(PENDING_UPLOAD)
  version            Int            @default(1)
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?
  expiresAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  uploadToken        String?        @unique @db.VarChar(64)
  uploadTokenExpires DateTime?      @db.Timestamptz(6)
  uploadConfirmed    Boolean        @default(false)
  confirmedAt        DateTime?      @db.Timestamptz(6)
  quarantineReason   String?
  flaggedAt          DateTime?      @db.Timestamptz(6)
  consentTimestamp   DateTime?      @map("consent_timestamp") @db.Timestamptz(6)
  retentionUntil     DateTime?      @map("retention_until") @db.Timestamptz(6)
  dataClassification String         @default("PERSONAL") @map("data_classification") @db.VarChar(20)
  member             Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, objectKey])
  @@index([uploadToken, uploadTokenExpires, status])
  @@index([retentionUntil])
  @@index([dataClassification, tenantId])
  @@index([tenantId, memberId, status])
  @@index([tenantId, memberId, type, status])
  @@index([status, expiresAt])
  @@schema("public")
}

model Account {
  id             String        @id @default(uuid())
  tenantId       String
  memberId       String
  accountNumber  String
  accountType    AccountType
  balance        Decimal       @default(0) @db.Decimal(18, 4)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  version        Int           @default(0)
  lockedBalance  Decimal       @default(0) @db.Decimal(18, 4)
  frozenSavings  Decimal       @default(0) @db.Decimal(18, 4)
  allowsNegative Boolean       @default(false)
  minimumBalance Decimal       @default(0) @db.Decimal(18, 4)
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId, memberId])
  @@index([tenantId, memberId, accountType, isActive])
  @@schema("public")
}

/// Tenant-configurable balance rules per account type (FOSA/BOSA).
/// Resolved onto Account.minimumBalance/allowsNegative at account-creation time;
/// editing a policy here does not retroactively change existing accounts.
model AccountTypePolicy {
  id             String      @id @default(uuid())
  tenantId       String
  accountType    AccountType
  minimumBalance Decimal     @default(0) @db.Decimal(18, 4)
  allowsNegative Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, accountType])
  @@index([tenantId])
  @@schema("public")
}

model LoanProduct {
  id                     String       @id @default(uuid())
  tenantId               String
  name                   String
  description            String?
  minAmount              Decimal      @db.Decimal(18, 4)
  maxAmount              Decimal      @db.Decimal(18, 4)
  interestRate           Decimal      @db.Decimal(7, 4)
  interestType           InterestType @default(REDUCING_BALANCE)
  maxTenureMonths        Int
  processingFeeRate      Decimal      @default(0) @db.Decimal(7, 4)
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  gracePeriodMonths      Int          @default(0)
  minActiveMonths        Int          @default(0)
  savingsMultiplier      Decimal      @default(3.0000) @db.Decimal(7, 4)
  maxGuarantors          Int          @default(3)
  minGuarantors          Int          @default(2)
  requiredAccountType    AccountType?
  requiresPayslip        Boolean      @default(false)
  guarantorCoverageRatio Decimal      @default(1.0) @db.Decimal(7, 4)
  gracePeriodDays        Int          @default(14)
  loans                  Loan[]
  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@schema("public")
}

model Loan {
  id                         String              @id @default(uuid())
  tenantId                   String
  memberId                   String
  loanProductId              String
  loanNumber                 String
  status                     LoanStatus          @default(DRAFT)
  principalAmount            Decimal             @db.Decimal(18, 4)
  interestRate               Decimal             @db.Decimal(7, 4)
  processingFee              Decimal             @default(0) @db.Decimal(18, 4)
  tenureMonths               Int
  monthlyInstalment          Decimal             @db.Decimal(18, 4)
  appliedAt                  DateTime            @default(now())
  approvedAt                 DateTime?
  approvedBy                 String?
  disbursedAt                DateTime?
  disbursedBy                String?
  dueDate                    DateTime?
  totalRepaid                Decimal             @default(0) @db.Decimal(18, 4)
  outstandingBalance         Decimal             @db.Decimal(18, 4)
  notes                      String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  purpose                    String?
  gracePeriodMonths          Int                 @default(0)
  arrearsAmount              Decimal             @default(0) @db.Decimal(18, 4)
  arrearsDays                Int                 @default(0)
  lastAccrualDate            DateTime?
  staging                    LoanStaging         @default(PERFORMING)
  accruedInterest            Decimal             @default(0) @db.Decimal(18, 4)
  repaymentScheduleGenerated Boolean             @default(false)
  disbursementFailureReason  String?
  guarantors                 LoanGuarantor[]
  loanProduct                LoanProduct         @relation(fields: [loanProductId], references: [id])
  member                     Member              @relation(fields: [memberId], references: [id])
  tenant                     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalChains             LoanApprovalChain[]
  loanRepayments             LoanRepayment[]
  supportTickets             SupportTicket[]
  transactions               Transaction[]

  @@unique([tenantId, loanNumber])
  @@index([tenantId, memberId])
  @@index([tenantId, loanProductId])
  @@index([tenantId, status])
  @@index([tenantId, staging])
  @@index([tenantId, staging, arrearsDays])
  @@schema("public")
}

model LoanGuarantor {
  id               String          @id @default(uuid())
  tenantId         String
  loanId           String
  memberId         String
  status           GuarantorStatus @default(PENDING)
  guaranteedAmount Decimal         @db.Decimal(18, 4)
  invitedAt        DateTime        @default(now())
  respondedAt      DateTime?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  auditMetadata    Json?
  recoveredAmount  Decimal         @default(0) @db.Decimal(18, 4)
  recoveryDate     DateTime?
  decidedByUserId  String?
  decisionSource   String?
  expiresAt        DateTime?
  holdPlacedAt     DateTime?
  holdReleasedAt   DateTime?
  loan             Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  member           Member          @relation(fields: [memberId], references: [id])
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([loanId, memberId])
  @@unique([tenantId, loanId, memberId])
  @@index([tenantId, status])
  @@index([tenantId, status, holdReleasedAt])
  @@index([tenantId, memberId])
  @@index([tenantId, loanId, status])
  @@index([loanId])
  @@map("Guarantor")
  @@schema("public")
}

model Transaction {
  id                  String            @id @default(uuid())
  tenantId            String
  accountId           String
  loanId              String?
  type                TransactionType
  status              TransactionStatus @default(PENDING)
  amount              Decimal           @db.Decimal(18, 4)
  balanceBefore       Decimal           @db.Decimal(18, 4)
  balanceAfter        Decimal           @db.Decimal(18, 4)
  reference           String
  description         String?
  processedBy         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  linkedTransactionId String?
  mpesaTransaction    MpesaTransaction?
  account             Account           @relation(fields: [accountId], references: [id])
  linkedTransaction   Transaction?      @relation("TransferPair", fields: [linkedTransactionId], references: [id])
  linkedTransactions  Transaction[]     @relation("TransferPair")
  loan                Loan?             @relation(fields: [loanId], references: [id])
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([tenantId, accountId])
  @@index([tenantId, accountId, type, createdAt])
  @@index([tenantId, loanId])
  @@index([tenantId, status, createdAt])
  @@index([reference])
  @@index([createdAt])
  @@index([linkedTransactionId])
  @@schema("public")
}

model MpesaTransaction {
  id                       String             @id @default(uuid())
  tenantId                 String
  transactionId            String?            @unique
  checkoutRequestId        String?            @unique
  merchantRequestId        String?
  phoneNumber              String
  amount                   Decimal            @db.Decimal(18, 4)
  status                   TransactionStatus  @default(PENDING)
  resultCode               Int?
  resultDesc               String?
  mpesaReceiptNumber       String?            @unique
  callbackPayload          Json?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  accountReference         String?
  conversationId           String?            @unique
  description              String?
  loanId                   String?
  loanRepaymentId          String?
  memberId                 String?
  originatorConversationId String?            @unique
  reference                String             @unique
  transactionDate          DateTime?
  triggerSource            MpesaTriggerSource
  type                     MpesaTxType
  failureReason            String?
  referenceId              String?
  referenceType            String?
  member                   Member?            @relation(fields: [memberId], references: [id])
  transaction              Transaction?       @relation(fields: [transactionId], references: [id])
  supportTickets           SupportTicket[]

  @@index([tenantId])
  @@index([tenantId, memberId])
  @@index([tenantId, loanId])
  @@index([tenantId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, type])
  @@index([checkoutRequestId])
  @@index([conversationId])
  @@index([reference])
  @@schema("public")
}

model LoanApprovalChain {
  id         String         @id @default(uuid())
  tenantId   String
  loanId     String
  approverId String
  role       String
  status     ApprovalStatus @default(PENDING)
  notes      String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())
  loan       Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([tenantId, loanId])
  @@schema("public")
}

model SupportTicket {
  id              String             @id @default(uuid())
  tenantId        String
  memberId        String
  subject         String
  description     String
  status          TicketStatus       @default(OPEN)
  priority        TicketPriority     @default(MEDIUM)
  category        TicketCategory     @default(GENERAL)
  relatedLoanId   String?
  relatedTxId     String?
  assignedTo      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  incidentId      String?
  resolutionDueAt DateTime?
  assignedToUser  User?              @relation("AssignedSupportTickets", fields: [assignedTo], references: [id])
  incident        Incident?          @relation(fields: [incidentId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])
  relatedLoan     Loan?              @relation(fields: [relatedLoanId], references: [id])
  relatedMpesaTx  MpesaTransaction?  @relation(fields: [relatedTxId], references: [id])
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments     TicketAttachment[]
  messages        TicketMessage[]

  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, assignedTo, status])
  @@index([tenantId, category, status])
  @@index([tenantId, incidentId])
  @@index([tenantId, resolutionDueAt])
  @@schema("public")
}

model Incident {
  id          String          @id @default(uuid())
  tenantId    String
  title       String
  description String
  severity    String
  status      String          @default("INVESTIGATING")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tickets     SupportTicket[]

  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([tenantId, createdAt])
  @@schema("public")
}

model InAppNotification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, userId, isRead])
  @@index([tenantId, userId, createdAt])
  @@schema("public")
}

model TicketMessage {
  id                String             @id @default(uuid())
  ticketId          String
  senderId          String
  content           String
  attachments       String[]
  createdAt         DateTime           @default(now())
  tenantId          String
  senderRole        UserRole
  ticketAttachments TicketAttachment[]
  sender            User               @relation(fields: [senderId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket            SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tenantId, ticketId, createdAt])
  @@schema("public")
}

model TicketAttachment {
  id        String         @id @default(uuid())
  tenantId  String
  ticketId  String
  messageId String?
  fileName  String
  fileKey   String
  mimeType  String
  size      Int
  createdAt DateTime       @default(now())
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket    SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId])
  @@index([tenantId, messageId])
  @@schema("public")
}

model LoginSession {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  ipHash    String
  userAgent String?
  geoHint   String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  isActive  Boolean  @default(true)

  @@index([tenantId, userId])
  @@index([ipHash])
  @@schema("public")
}

model WebhookSubscription {
  id         String            @id @default(uuid())
  tenantId   String
  url        String
  secret     String
  events     String[]
  status     WebhookStatus     @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@schema("public")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  subscriptionId String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  httpStatus     Int?
  responseBody   String?
  attempts       Int                   @default(0)
  nextRetryAt    DateTime?
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@schema("public")
}

model IntegrationOutbox {
  id              String       @id @default(uuid())
  tenantId        String
  idempotencyKey  String       @unique
  integrationType String
  payload         Json
  status          OutboxStatus @default(PENDING)
  attempts        Int          @default(0)
  maxAttempts     Int          @default(5)
  lastError       String?
  nextRetryAt     DateTime?
  processedAt     DateTime?
  deadLetteredAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@index([status, nextRetryAt])
  @@index([integrationType, status])
  @@schema("public")
}

model CrbReport {
  id              String          @id @default(uuid())
  tenantId        String
  loanIds         String[]
  periodStart     DateTime
  periodEnd       DateTime
  xmlPayload      String
  status          CrbReportStatus @default(PENDING)
  submittedAt     DateTime?
  responseCode    String?
  responseMessage String?
  outboxId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@schema("public")
}

