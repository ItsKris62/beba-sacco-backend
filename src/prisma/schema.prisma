/// Tracks every CSV/Excel import job with full audit trail
model DataImportLog {
  id           String          @id @default(uuid())
  tenantId     String
  /// UUID used as idempotency key – stored on imported User.importBatchId
  batchId      String          @unique @default(uuid())
  /// Who triggered the import
  initiatedBy  String
  /// Source file metadata
  fileName     String
  fileSize     Int
  totalRows    Int             @default(0)
  /// Processing counters (updated by worker)
  successCount Int             @default(0)
  failedCount  Int             @default(0)
  warningCount Int             @default(0)
  skippedCount Int             @default(0)
  status       ImportJobStatus @default(QUEUED)
  /// Whether this was a dry-run (preview only, no DB writes)
  dryRun       Boolean         @default(false)
  /// Row-level validation failures: { row, field, value, reason, errorCode }[]
  errorDetails Json?
  /// Structured summary report
  reportData   Json?
  /// BullMQ job ID for polling
  queueJobId   String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([batchId])
  @@index([initiatedBy])
  @@schema("public")
}

/// Maps a KYC stage to the documents required to pass that stage.
