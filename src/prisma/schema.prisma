  @@map("kyc_requirements")
  @@schema("public")
}

/// Chart of Accounts – tenant-scoped hierarchical account tree.
/// System accounts (isSystemAccount=true) are seeded on tenant creation
/// and cannot be deleted or re-coded by the tenant admin.
model GLAccount {
  id              String        @id @default(uuid())
  tenantId        String
  code            String
  name            String
  type            GLAccountType
  parentId        String?
  isSystemAccount Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  parent          GLAccount?    @relation("GLAccountHierarchy", fields: [parentId], references: [id])
  children        GLAccount[]   @relation("GLAccountHierarchy")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditPostings  GLPosting[]   @relation("GLPostingCredit")
  debitPostings   GLPosting[]   @relation("GLPostingDebit")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@index([tenantId, parentId])
  @@schema("public")
}

/// Double-entry journal entry with maker-checker approval workflow.
/// Each entry has one or more GLPosting lines where sum(debits) = sum(credits).
///
/// Auto-numbering: JE-{YYYY}-{seq} per tenant.
/// Entries with totalAmount >= KES 100,000 require MANAGER approval.
model JournalEntry {
  id            String             @id @default(uuid())
  tenantId      String
  entryNumber   String
  type          JournalEntryType
  status        JournalEntryStatus @default(DRAFT)
  description   String
  referenceType String?
  referenceId   String?
  totalAmount   Decimal            @db.Decimal(18, 4)
  createdById   String
  approvedById  String?
  rejectedById  String?
  approvalNotes String?
  postedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reversalOfJournalEntryId String?
  postings      GLPosting[]
  approvedBy    User?              @relation("JournalEntryApprover", fields: [approvedById], references: [id])
  createdBy     User               @relation("JournalEntryCreator", fields: [createdById], references: [id])
  rejectedBy    User?              @relation("JournalEntryRejector", fields: [rejectedById], references: [id])
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reversalOf    JournalEntry?      @relation("JournalEntryReversal", fields: [reversalOfJournalEntryId], references: [id])
  reversals     JournalEntry[]     @relation("JournalEntryReversal")

  @@unique([tenantId, entryNumber])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, createdById])
  @@index([tenantId, approvedById])
  @@index([tenantId, rejectedById])
  @@index([reversalOfJournalEntryId])
  @@index([tenantId, referenceType, referenceId])
  @@schema("public")
}

/// Individual debit or credit line within a journal entry.
/// Each posting touches exactly one debit account and one credit account.
model GLPosting {
  id              String       @id @default(uuid())
  journalEntryId  String
  debitAccountId  String?
  creditAccountId String?
  amount          Decimal      @db.Decimal(18, 4)
  description     String?
  postingDate     DateTime     @default(now())
  createdAt       DateTime     @default(now())
  creditAccount   GLAccount?   @relation("GLPostingCredit", fields: [creditAccountId], references: [id])
  debitAccount    GLAccount?   @relation("GLPostingDebit", fields: [debitAccountId], references: [id])
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@schema("public")
}

